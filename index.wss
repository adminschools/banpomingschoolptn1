dth="450" originheight="301" src="D:\websiteschool68\images\5.gif" previewfile="D:\websiteschool68\images\5.gif" thumbname="thumb21499078" resamplename="img21499093" exportfilename="images/5.gif"/><Component type="3" id="image80" zorder="71" filename="image896716656" left="210" top="301" width="164" height="28" originwidth="180" originheight="28" src="D:\websiteschool68\images\52.gif" previewfile="D:\websiteschool68\images\52.gif" linkurl="https://forms.gle/D7xPwAeBvipWWo2TA" lp="0" thumbname="thumb37646031" resamplename="img37646046" exportfilename="images/52.gif"/><Component type="3" id="image81" zorder="72" filename="image896716640" left="403" top="301" width="179" height="28" originwidth="180" originheight="28" src="D:\websiteschool68\images\48.gif" previewfile="D:\websiteschool68\images\48.gif" linkurl="page://p277803703" lp="0" thumbname="thumb37646078" resamplename="img37646093" exportfilename="images/48.gif"/><Component type="3" id="image79" zorder="73" filename="image896716625" left="611" top="301" width="165" height="28" originwidth="180" originheight="28" src="D:\websiteschool68\images\55.gif" previewfile="D:\websiteschool68\images\55.gif" linkurl="https://script.google.com/a/macros/pattani1.go.th/s/AKfycbyFAEP0hJjilFj_RQJKzVWFPugSPU-b-4ck6aJ487jzVLwNMZWb2ye4qzFnbsTPjquslg/exec" lp="0" thumbname="thumb37646125" resamplename="img37646140" exportfilename="images/55.gif"/><Component type="12" id="html1" zorder="74" filename="html896716609" script="&lt;!DOCTYPE html&gt;
&lt;html&gt;


&lt;head&gt;
  &lt;base target=&quot;_top&quot;&gt;
  &lt;style&gt;
    .inputtext {
      width: 100%;
      vertical-align: middle;
      margin: 5px 10px 5px 0;
      padding: 10px;
      background-color: #ffffff;
      border: 2px solid #000;
      border-radius: 20px;
      box-sizing: border-box;


    }


    .button {
      width: 100%;
      vertical-align: middle;
      margin: 5px 10px 5px 0;
      padding: 10px;
      background-color: #8049FF;
      border: 2px solid #000;
      border-radius: 20px;
      box-sizing: border-box;
      text-transform: uppercase;
      color:white;
    }


    div {
      font-family: arial;
      font-weight: bold;


    }


    #msg {
      color: #000000;
    }


    body {
      overflow-y: hidden;
      /* Hide vertical scrollbar */
      overflow-x: hidden;
      /* Hide horizontal scrollbar */



    }
  &lt;/style&gt;
&lt;/head&gt;


&lt;body&gt;
  &lt;center&gt;
    &lt;center&gt;
      &lt;div class=&quot;div1&quot;&gt;
        &lt;form name=&quot;myform&quot; method=&quot;post&quot;&gt;


          &lt;input type=&quot;text&quot; name=&quot;uname&quot; class=&quot;inputtext&quot; autocomplete=&quot;off&quot; placeholder=&quot;username&quot;&gt;
          &lt;br&gt;
          &lt;input type=&quot;password&quot; name=&quot;pass&quot; class=&quot;inputtext&quot; autocomplete=&quot;off&quot; placeholder=&quot;password&quot;&gt;
          &lt;br&gt;
          &lt;div id=&quot;msg&quot;&gt;&lt;/div&gt;
          &lt;br&gt;
          &lt;input type=&quot;button&quot; class=&quot;button&quot; name=&quot;log&quot; id=&quot;logbutton&quot; value=&quot;Login&quot; onclick=&quot;myfunction()&quot;&gt;
          &lt;br&gt;&lt;br&gt;
        &lt;/form&gt;
      &lt;/div&gt;
    &lt;/center&gt;
  &lt;/center&gt;
  &lt;script type=&quot;text/javascript&quot;&gt;
    function myfunction () {
    var user = document.forms[&quot;myform&quot;][&quot;uname&quot;].value;
    var pass = document.forms[&quot;myform&quot;][&quot;pass&quot;].value;
    if (user==&quot;adminweb&quot; &amp;&amp; pass==&quot;sunsdi68&quot;)
  {
    window.open('https://github.com/login', '_blank');
  }
    else
  {
    document.getElementById(&quot;msg&quot;).innerHTML = &quot;Is Faild try again&quot;;
  }
  }

  &lt;/script&gt;
